# ============================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================
# Este archivo es solo un ejemplo.
# NO usar credenciales reales aquí.
# Para usar variables reales, copia este archivo a .env:
#   cp .env.example .env
# ============================================

# Nombre de la aplicación
APP_NAME="Reserva Horas Médicas"

# Entorno de ejecución (development | production)
APP_ENV=development

# Modo debug (true | false)
APP_DEBUG=true

# Puerto del servicio web
APP_PORT=8080

# Servidor web utilizado
WEB_SERVER=nginx

# Nivel de logs (info | warn | error)
LOG_LEVEL=info